[run]
source = .
omit =
    # 排除测试文件
    tests/*
    # 排除初始化文件
    */__init__.py
    # 排除配置文件
    setup.py
    conftest.py
    # 排除工具类
    utils/*
    # 排除 Docker 相关
    Dockerfile
    # 排除缓存
    __pycache__/*
    *.pyc
    # 排除虚拟环境
    venv/*
    .venv/*
    # 排除 IDE 配置
    .idea/*
    # 排除数据文件
    data/*

[report]
show_missing = True
skip_covered = False
skip_empty = True
precision = 2
exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug:
    if settings.DEBUG
    raise AssertionError
    raise NotImplementedError
    if 0:
    if __name__ == .__main__.:
    class .*Protocol:
    @abc.abstractmethod
